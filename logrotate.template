# PondCDRSuite logrotate configuration (generated from logrotate.template)
# Rendered per project (cdr_copy, cdr_sync) during deployment: log directory
# and owning user are substituted into the rules below.
__LOG_DIR__/*.log {
    daily
    maxsize 1G
    rotate 3
    compress
    missingok
    notifempty
    copytruncate
    su __DEPLOY_USER__ __DEPLOY_USER__
}

__LOG_DIR__/*.json {
    daily
    maxsize 1G
    rotate 3
    compress
    missingok
    notifempty
    copytruncate
    su __DEPLOY_USER__ __DEPLOY_USER__
}
